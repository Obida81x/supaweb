# =============================================================================
# SupaWeb API Server — Environment Variables
# =============================================================================
#
# Copy this file to .env for local development.
# On Render, set these in: Service → Environment.
# =============================================================================

# --- Required ---

# PostgreSQL connection string (Neon in production, Replit built-in in dev)
# Neon format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session encryption secret — must be a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret

# --- Server ---

# Render sets PORT automatically. Default: 8080
PORT=8080

# Set to "production" on Render
NODE_ENV=production

# --- CORS ---

# Comma-separated list of allowed frontend origins.
# Example: https://supaweb.vercel.app,https://www.supaweb.dev
CORS_ORIGIN=https://your-app.vercel.app

# --- Optional ---

# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
