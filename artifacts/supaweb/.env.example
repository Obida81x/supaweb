# =============================================================================
# SupaWeb Frontend — Environment Variables
# =============================================================================
#
# Copy this file to .env.local for local development overrides.
# On Vercel, set these in: Project Settings → Environment Variables
#
# IN DEVELOPMENT (Replit):
#   Do NOT set VITE_API_BASE_URL — Replit's proxy routes /api automatically.
#
# IN PRODUCTION (Vercel → Render):
#   Set VITE_API_BASE_URL to your Render backend URL (no trailing slash).
# =============================================================================

# API base URL — your Render backend service URL.
# Example: https://supaweb-api.onrender.com
# Leave empty/unset in Replit development.
VITE_API_BASE_URL=https://your-api-service.onrender.com
